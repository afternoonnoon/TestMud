@page "/student"
@using TestMud.Models
@inject IUserService UserService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Student</PageTitle>

<h3>Add User</h3>

<MudPaper Class="p-4">
    <MudForm>
        <MudTextField @bind-Value="NewUser.Name" Required="true" HelperText="Name" />
        <MudTextField @bind-Value="NewUser.Email" Required="true" Type="email" HelperText="Email" />

        <MudButton OnClick="AddUser" Color="Color.Primary">Save</MudButton>
        <MudButton OnClick="GoToUserList" Color="Color.Secondary">Go to User List</MudButton>
    </MudForm>
</MudPaper>

@code {
    private User NewUser = new();

    private async Task AddUser()
    {
        if (string.IsNullOrWhiteSpace(NewUser.Name) || string.IsNullOrWhiteSpace(NewUser.Email))
        {
            Snackbar.Add("Can not be Empty!", Severity.Warning);
            return;
        }

        await UserService.AddUserAsync(NewUser);
        Snackbar.Add("Add User successfully!", Severity.Success);

        NewUser = new(); // รีเซ็ตฟอร์ม
    }

    private void GoToUserList()
    {
        Nav.NavigateTo("/data");
    }
}
