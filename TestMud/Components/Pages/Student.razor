@page "/student"
<PageTitle>Student</PageTitle>

<h1>Student</h1>

Welcome to student list.

<MudCard>
    <MudCardHeader>
        <MudText Typo="Typo.h6">Student List</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudDataGrid Items="@products" Dense="true" Hover="true" Elevation="2" Bordered="true">
            <Columns>
                <PropertyColumn Property="x => x.StudentId" Title="ID" Sortable="true" />
                <PropertyColumn Property="x => x.Name" Title="Name" Sortable="true" />
                <PropertyColumn Property="x => x.Surname" Title="Surname" />
                <PropertyColumn Property="x => x.Status" />
                <PropertyColumn Property="x => x.Major" />
                <PropertyColumn Property="x => x.Faculty" />
            </Columns>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

